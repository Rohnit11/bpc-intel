# Raw fetcher outputs — large, regenerable
data/raw/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# API keys — never commit
config/api_keys.yaml

# OS
Thumbs.db
desktop.ini

# Original download copies (canonical versions live in BUILD-SPEC.md and data/baseline/)
bpc-intel-build-spec (1).md
deep-research-report (1).md
data/manual/*
!data/manual/.gitkeep
# Analyst insights ARE committed — Claude-authored commentary (not a
# subscription vendor drop), the curated source for the dashboard's
# "Analyst read" panels. See commands/insights.md.
!data/manual/insights/
!data/manual/insights/**
# Entry-analysis artifacts ARE committed — Claude-authored strategic analysis
# (Porter, scorecard, profiles...), diffable source for the dashboard's entry
# layer. See commands/entry-analysis.md.
!data/manual/analysis/
!data/manual/analysis/**
# Entry-analysis artifacts likewise (see commands/entry-analysis.md)
!data/manual/analysis/
!data/manual/analysis/**
# Research drops stay ignored as a class (the ledger is data/sources.csv), with
# one exception: the premium-skincare Phase 3 drop is committed so its 14
# externally-sourced claims — Nykaa filings, the MOFSL note, the affordability
# ESTIMATEs and their methodology — are diffable next to the phase doc that
# argues from them. Re-ignoring the directory contents on the line below keeps
# the other drops out; drop the `*` line to track them all.
!data/manual/research_drops/
data/manual/research_drops/*
!data/manual/research_drops/premium_skin_demand.json

# Report archives — regenerable dev churn
reports/archive/

# Playwright MCP scratch (page snapshots / console logs from browser tooling)
.playwright-mcp/

# Web dashboard (web/public/data/*.json bundle and web/types/*.ts ARE
# committed — they are the deploy input / generated types, not build output)
web/node_modules/
web/.next/
web/scripts/_generated-schema.json
