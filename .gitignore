# Raw fetcher outputs — large, regenerable
data/raw/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# API keys — never commit
config/api_keys.yaml

# OS
Thumbs.db
desktop.ini

# Original download copies (canonical versions live in BUILD-SPEC.md and data/baseline/)
bpc-intel-build-spec (1).md
deep-research-report (1).md
data/manual/*
!data/manual/.gitkeep

# Report archives — regenerable dev churn
reports/archive/

# Web dashboard (web/public/data/*.json bundle and web/types/*.ts ARE
# committed — they are the deploy input / generated types, not build output)
web/node_modules/
web/.next/
web/scripts/_generated-schema.json
