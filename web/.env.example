# Copy to .env.local for local dev, and set these in Vercel's Project Settings
# > Environment Variables for the deployed site.

# --- Access gate (required) ---
# Shared password gating the whole dashboard (see proxy.ts).
SITE_PASSWORD=changeme
# Secret used to HMAC-sign the auth cookie. Any long random string.
AUTH_SECRET=changeme-too

# --- Assistant (/ask) — optional; the route returns 503 until set ---
# Provider for the grounded chatbot: xai | google | anthropic
#
# NOTE ON xAI FREE CREDITS: xAI's free monthly credits are reported to require
# joining a data-sharing programme, under which your API traffic may be used
# for model training. This repo's context includes licensed Euromonitor/Statista
# figures that /methodology commits to NOT redistributing, plus unpublished
# strategy. Keep data sharing DISABLED and pay per token — the corpus is small,
# so cost is minimal — or use another provider.
CHAT_PROVIDER=xai
CHAT_API_KEY=
# Optional model override (defaults per provider: grok-4.1-fast /
# gemini-2.5-flash / claude-sonnet-4-5)
# CHAT_MODEL=

# --- Knowledge-gap loop (optional) ---
# Neon Postgres connection string. When set, every question is logged and
# unanswered ones are harvested weekly into the research backlog.
# Apply web/db/schema.sql once before first use.
DATABASE_URL=
