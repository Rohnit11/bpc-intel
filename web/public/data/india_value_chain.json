  "findings": {
    "supply_chain": [
      {
        "text": "Most Indian D2C beauty brands do NOT own factories — they use third-party contract manufacturers / private-label houses (e.g. Gorgeous Cosmos, and hundreds listed on IndiaMART), with MOQs from ~500 units. The brand owns formula/brand; the CM owns production.",
        "source": "Gorgeous Cosmos; IndiaMART",
        "url": "https://gorgeouscosmos.in/news/india-1-private-label-cosmetic-manufacturer"
      },
      {
        "text": "FMCG brands demand audit-readiness/scale from CMs; D2C brands demand agility, small batches, and RM-sourcing transparency — two different contract-manufacturing service models.",
        "source": "IMARC Engineering",
        "url": "https://www.imarcengineering.com/blog/contract-manufacturing-in-india"
      },
      {
        "text": "Upstream, specialty-ingredient suppliers underpin the chain: Galaxy Surfactants (mild surfactants for cleansers) and Fine Organics (oleochemical specialty additives) are key Indian actives/ingredient makers.",
        "source": "Marcellus; GlobalData",
        "url": "https://marcellus.in/newsletter/little-champs/spotlighting-galaxy-surfactants"
      }
    ],
